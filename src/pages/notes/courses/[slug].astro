---
import DetailLayout from '../../../layouts/DetailLayout.astro';

export function getStaticPaths() {
  const courses = [
    { slug: 'optimization-methods', title: '最优化方法', room: '理教 106' },
    { slug: 'applied-stochastic-processes', title: '应用随机过程', room: '理教 402' },
    { slug: 'numerical-linear-algebra', title: '数值代数', room: '二教 101' },
    { slug: 'partial-differential-equations', title: '偏微分方程', room: '理教 103' },
    { slug: 'deep-learning-and-rl', title: '深度学习与强化学习', room: '研本合上' },
    { slug: 'chinese-bureaucratic-politics', title: '中国传统官僚政治制度', room: '二教 207' },
  ];

  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props;
---

<DetailLayout
  title={course.title}
  eyebrow="COURSE NOTES · 2026 秋"
  description={`${course.room} · 课程笔记会从这里慢慢长出来。`}
>
  <section class="course-overview">
    <div>
      <p class="resource-type">课程笔记</p>
      <h2>{course.title}</h2>
      <p>{course.slug === 'optimization-methods' ? 'Lecture 3 已上传，后续会继续补充。' : '暂时还是一页空白，等第一条值得留下的笔记。'}</p>
    </div>
    <span class="course-status"><i></i> 整理中</span>
  </section>

  {course.slug === 'optimization-methods' && (
    <section class="detail-section course-materials">
      <p class="detail-label">LECTURE NOTES</p>
      <h2>Lecture 3</h2>
      <a class="resource-file" href="/notes/courses/optimization-methods/lec3-20260921.pdf" target="_blank" rel="noreferrer">
        <span>最优化方法 · Lecture 3</span>
        <small>打开 PDF ↗</small>
      </a>
    </section>
  )}
</DetailLayout>
