---
import DetailLayout from '../../layouts/DetailLayout.astro';

const currentCourses = [
  { title: '最优化方法', href: '/notes/courses/optimization-methods/' },
  { title: '应用随机过程', href: '/notes/courses/applied-stochastic-processes/' },
  { title: '数值代数', href: '/notes/courses/numerical-linear-algebra/' },
  { title: '偏微分方程', href: '/notes/courses/partial-differential-equations/' },
  { title: '深度学习与强化学习', href: '/notes/courses/deep-learning-and-rl/' },
  { title: '中国传统官僚政治制度', href: '/notes/courses/chinese-bureaucratic-politics/' },
];

const pastCourses = [
  { title: '应用随机分析', term: '2026 春', href: '/notes/applied-stochastic-calculus/' },
];
---

<DetailLayout
  title="一些笔记"
  eyebrow="NOTES"
  description="课程里的认真推导，以及生活和阅读留下的一点页边痕迹。"
>
  <section id="course-notes" class="notes-term-section">
    <div class="notes-term-heading">
      <div>
        <p class="detail-label">COURSE NOTES</p>
        <h2>课程笔记</h2>
      </div>
      <span>按学期整理</span>
    </div>

    <div class="notes-subterm">
      <h3>本学期笔记</h3>
      <span>大三上 · 2026 秋</span>
    </div>
    <div class="notes-index-grid">
      {currentCourses.map((course, index) => (
        <a href={course.href}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{course.title}</h3>
          <i>Notes →</i>
        </a>
      ))}
    </div>

    <div class="notes-subterm past-notes-subterm">
      <h3>往期笔记</h3>
      <span>偶尔复习</span>
    </div>
    <div class="notes-index-grid">
      {pastCourses.map((course, index) => (
        <a href={course.href}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{course.title}</h3>
          <i>{course.term} →</i>
        </a>
      ))}
    </div>
  </section>

  <section id="marginalia" class="notes-term-section">
    <div class="notes-term-heading">
      <div>
        <p class="detail-label">MARGINALIA</p>
        <h2>页边小记</h2>
      </div>
      <span>生活 · 阅读 · 偶得</span>
    </div>
    <div class="notes-empty-state">
      <p>第一页暂时还是空的。</p>
      <span>等某个值得留下的念头经过这里。</span>
    </div>
  </section>
</DetailLayout>
